DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/reviews
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM: openai (any OpenAI-compatible API, e.g. Groq) | ollama-llama | stub
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=

# Embeddings: gemini | hash (offline, non-semantic; tests only)
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
GOOGLE_API_KEY=

# Hosted demo
AUTO_BOOTSTRAP=false
DEMO_READ_ONLY=false
ENABLE_SCRAPING=true
QA_RATE_LIMIT_PER_HOUR=60
CORS_ORIGINS=*
